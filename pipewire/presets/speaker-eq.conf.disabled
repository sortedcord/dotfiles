# Speaker tuning for the Lenovo laptop's 2x 2W front-facing speakers.
# Virtual sink "Laptop Speakers (Tuned)" -> EQ -> default hardware sink.
#
# Tiny drivers can't reproduce deep bass, they just distort. So instead of
# boosting the sub-bass we:
#   1. high-pass below ~100 Hz (protects the drivers, frees up headroom)
#   2. lift the upper bass (150-250 Hz) so the ear fills in the missing low end
#   3. cut the 350-450 Hz "boxy" mud, add a little presence/air
#   4. apply -6 dB preamp so the boosts don't clip
#
# Tweak the gains below, then: systemctl --user restart pipewire pipewire-pulse wireplumber
context.modules = [
    { name = libpipewire-module-filter-chain
        args = {
            node.description = "Laptop Speakers (Tuned)"
            media.name       = "Laptop Speakers (Tuned)"
            filter.graph = {
                nodes = [
                    # Preamp (linear gain = 10^(-6/20) ~= 0.5)
                    { type = builtin name = preamp label = linear
                      control = { "Mult" = 0.5 "Add" = 0.0 } }
                    # 4th-order high-pass (two cascaded 2nd-order) at 100 Hz
                    { type = builtin name = hp1 label = bq_highpass
                      control = { "Freq" = 100.0 "Q" = 0.71 } }
                    { type = builtin name = hp2 label = bq_highpass
                      control = { "Freq" = 100.0 "Q" = 0.71 } }
                    # Upper-bass warmth
                    { type = builtin name = bass label = bq_lowshelf
                      control = { "Freq" = 200.0 "Q" = 0.7 "Gain" = 4.0 } }
                    { type = builtin name = punch label = bq_peaking
                      control = { "Freq" = 140.0 "Q" = 1.0 "Gain" = 2.0 } }
                    # Cut boxy mud
                    { type = builtin name = mud label = bq_peaking
                      control = { "Freq" = 400.0 "Q" = 1.0 "Gain" = -2.5 } }
                    # Vocal presence
                    { type = builtin name = presence label = bq_peaking
                      control = { "Freq" = 3000.0 "Q" = 1.0 "Gain" = 2.0 } }
                    # Tame harshness around 6 kHz, then a touch of air
                    { type = builtin name = harsh label = bq_peaking
                      control = { "Freq" = 6000.0 "Q" = 2.0 "Gain" = -1.5 } }
                    { type = builtin name = air label = bq_highshelf
                      control = { "Freq" = 9000.0 "Q" = 0.7 "Gain" = 1.5 } }
                ]
                links = [
                    { output = "preamp:Out"   input = "hp1:In" }
                    { output = "hp1:Out"      input = "hp2:In" }
                    { output = "hp2:Out"      input = "bass:In" }
                    { output = "bass:Out"     input = "punch:In" }
                    { output = "punch:Out"    input = "mud:In" }
                    { output = "mud:Out"      input = "presence:In" }
                    { output = "presence:Out" input = "harsh:In" }
                    { output = "harsh:Out"    input = "air:In" }
                ]
                inputs  = [ "preamp:In" ]
                outputs = [ "air:Out" ]
            }
            audio.channels = 2
            audio.position = [ FL FR ]
            capture.props = {
                node.name       = "effect_input.speaker_tuning"
                media.class     = Audio/Sink
                priority.session = 2000
            }
            playback.props = {
                node.name    = "effect_output.speaker_tuning"
                node.passive = true
            }
        }
    }
]
