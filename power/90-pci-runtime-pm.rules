# PCI runtime power management, installed to /etc/udev/rules.d/ by install.sh.
# Sets power/control to "auto" for the devices PowerTOP flagged as "on".
SUBSYSTEM=="pci", KERNEL=="0000:00:00.0", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:00:04.0", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:00:0a.0", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:00:12.0", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:00:14.2", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:00:1f.0", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:00:1f.5", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:01:00.0", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:02:00.0", ATTR{power/control}="auto"
SUBSYSTEM=="pci", KERNEL=="0000:03:00.0", ATTR{power/control}="auto"
