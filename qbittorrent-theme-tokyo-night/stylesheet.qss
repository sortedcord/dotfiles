/* Tokyo Night Storm — qBittorrent theme (derived from Kitty colors.conf)
 *
 * Palette:
 *   bg:      #0e1017 (background)
 *   alt-bg:  #161925 (subtle alternating row)
 *   surface: #24283B (color0)
 *   border:  #444B6A (color8)
 *   muted:   #787C99 (foreground / color7)
 *   fg:      #D5D6DB (color15)
 *   accent:  #8698df (color4 / color6)
 *   purple:  #BB9AF7 (color5)
 *   teal:    #41A6B5 (color2)
 *   amber:   #E0AF68 (color3)
 *   red:     #F7768E (color1)
 */

QWidget {
    background-color: #0e1017;
    color: #D5D6DB;
    selection-background-color: #8698df;
    selection-color: #0e1017;
}

QWidget:disabled {
    color: #787C99;
}

QMainWindow,
QDialog {
    background-color: #0e1017;
}

QMainWindow::separator {
    background-color: #444B6A;
    width: 1px;
    height: 1px;
}

QSplitter::handle {
    background-color: #24283B;
}

QSplitter::handle:hover {
    background-color: #8698df;
}

/* Menu bar & menus */
QMenuBar {
    background-color: #0e1017;
    color: #D5D6DB;
    border-bottom: 1px solid #24283B;
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #24283B;
    color: #D5D6DB;
}

QMenu {
    background-color: #24283B;
    color: #D5D6DB;
    border: 1px solid #444B6A;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 10px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #444B6A;
    color: #D5D6DB;
}

QMenu::item:disabled {
    color: #787C99;
}

QMenu::separator {
    height: 1px;
    background-color: #444B6A;
    margin: 4px 6px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(:/uitheme/controls/checkbox-unchecked.svg);
}

QMenu::indicator:non-exclusive:checked {
    image: url(:/uitheme/controls/checkbox-checked.svg);
}

QMenu::indicator:exclusive:unchecked {
    image: url(:/uitheme/controls/radio-unchecked.svg);
}

QMenu::indicator:exclusive:checked {
    image: url(:/uitheme/controls/radio-checked.svg);
}

/* Toolbar */
QToolBar {
    background-color: #0e1017;
    border: none;
    border-bottom: 1px solid #24283B;
    spacing: 4px;
    padding: 3px 6px;
}

QToolBar::separator {
    background-color: #444B6A;
    width: 1px;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #D5D6DB;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px 6px;
}

QToolButton:hover {
    background-color: #24283B;
    border-color: #444B6A;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #444B6A;
    border-color: #8698df;
}

QToolButton::menu-indicator {
    image: url(:/uitheme/controls/arrow-down.svg);
    width: 10px;
    height: 10px;
    subcontrol-position: right center;
    subcontrol-origin: padding;
    padding-right: 2px;
}

/* Status bar */
QStatusBar {
    background-color: #0e1017;
    color: #787C99;
    border-top: 1px solid #24283B;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #D5D6DB;
    background-color: transparent;
}

/* Buttons */
QPushButton {
    background-color: #24283B;
    color: #D5D6DB;
    border: 1px solid #444B6A;
    border-radius: 5px;
    padding: 5px 12px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #2d334b;
    border-color: #8698df;
}

QPushButton:pressed {
    background-color: #444B6A;
}

QPushButton:default {
    border-color: #8698df;
}

QPushButton:disabled {
    background-color: #161925;
    color: #787C99;
    border-color: #24283B;
}

/* Inputs */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox,
QDateTimeEdit {
    background-color: #161925;
    color: #D5D6DB;
    border: 1px solid #444B6A;
    border-radius: 5px;
    padding: 4px 8px;
    selection-background-color: #8698df;
    selection-color: #0e1017;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus,
QDateTimeEdit:focus {
    border-color: #8698df;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    background-color: #0e1017;
    color: #787C99;
    border-color: #24283B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #444B6A;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #24283B;
}

QComboBox::down-arrow {
    image: url(:/uitheme/controls/arrow-down.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #24283B;
    color: #D5D6DB;
    border: 1px solid #444B6A;
    selection-background-color: #8698df;
    selection-color: #0e1017;
    outline: 0;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #444B6A;
    border-bottom: 1px solid #444B6A;
    border-top-right-radius: 5px;
    background-color: #24283B;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid #444B6A;
    border-bottom-right-radius: 5px;
    background-color: #24283B;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #444B6A;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/uitheme/controls/arrow-up.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/uitheme/controls/arrow-down.svg);
    width: 9px;
    height: 9px;
}

/* Checkboxes & radio buttons */
QCheckBox,
QRadioButton {
    spacing: 6px;
    color: #D5D6DB;
    background-color: transparent;
}

QCheckBox::indicator,
QGroupBox::indicator {
    width: 15px;
    height: 15px;
}

QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked {
    image: url(:/uitheme/controls/checkbox-unchecked.svg);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
    image: url(:/uitheme/controls/checkbox-checked.svg);
}

QCheckBox::indicator:indeterminate {
    image: url(:/uitheme/controls/checkbox-indeterminate.svg);
}

QRadioButton::indicator {
    width: 15px;
    height: 15px;
}

QRadioButton::indicator:unchecked {
    image: url(:/uitheme/controls/radio-unchecked.svg);
}

QRadioButton::indicator:checked {
    image: url(:/uitheme/controls/radio-checked.svg);
}

/* Views & tables (preserve TransferList state foreground colors) */
QTreeView,
QTableView,
QListView {
    background-color: #0e1017;
    alternate-background-color: #161925;
    color: #D5D6DB;
    border: 1px solid #24283B;
    gridline-color: #24283B;
    outline: 0;
}

QTreeView::item:hover,
QTableView::item:hover,
QListView::item:hover {
    background-color: rgba(68, 75, 106, 0.35);
}

QTreeView::item:selected,
QTableView::item:selected,
QListView::item:selected {
    background-color: rgba(134, 152, 223, 0.24);
    color: #D5D6DB;
}

QTreeView::indicator:unchecked {
    image: url(:/uitheme/controls/checkbox-unchecked.svg);
}

QTreeView::indicator:checked {
    image: url(:/uitheme/controls/checkbox-checked.svg);
}

QTreeView::indicator:indeterminate {
    image: url(:/uitheme/controls/checkbox-indeterminate.svg);
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: url(:/uitheme/controls/branch-closed.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: url(:/uitheme/controls/branch-open.svg);
}

QHeaderView {
    background-color: #24283B;
    color: #D5D6DB;
    border: none;
}

QHeaderView::section {
    background-color: #24283B;
    color: #D5D6DB;
    border: none;
    border-right: 1px solid #444B6A;
    border-bottom: 1px solid #444B6A;
    padding: 4px 8px;
}

QHeaderView::section:hover {
    background-color: #2d334b;
}

QHeaderView::up-arrow {
    image: url(:/uitheme/controls/arrow-up.svg);
    width: 9px;
    height: 9px;
}

QHeaderView::down-arrow {
    image: url(:/uitheme/controls/arrow-down.svg);
    width: 9px;
    height: 9px;
}

QTableCornerButton::section {
    background-color: #24283B;
    border: none;
    border-right: 1px solid #444B6A;
    border-bottom: 1px solid #444B6A;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #24283B;
    background-color: #0e1017;
    top: -1px;
}

QTabBar::tab {
    background-color: #161925;
    color: #787C99;
    border: 1px solid #24283B;
    border-bottom: none;
    padding: 6px 12px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:hover {
    background-color: #24283B;
    color: #D5D6DB;
}

QTabBar::tab:selected {
    background-color: #24283B;
    color: #D5D6DB;
    border-color: #444B6A;
    border-bottom: 2px solid #8698df;
}

/* Group boxes & frames */
QGroupBox {
    border: 1px solid #444B6A;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 8px;
    color: #D5D6DB;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #8698df;
    background-color: #0e1017;
}

/* Progress bars */
QProgressBar {
    background-color: #24283B;
    color: #D5D6DB;
    border: 1px solid #444B6A;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #8698df;
    border-radius: 3px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #0e1017;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #444B6A;
    min-height: 24px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #787C99;
}

QScrollBar:horizontal {
    background-color: #0e1017;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #444B6A;
    min-width: 24px;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #787C99;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #24283B;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #8698df;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #D5D6DB;
    border: 2px solid #8698df;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 7px;
}

/* Tooltips */
QToolTip {
    background-color: #24283B;
    color: #D5D6DB;
    border: 1px solid #444B6A;
    padding: 4px 6px;
    border-radius: 4px;
}

/* Labels */
QLabel {
    background-color: transparent;
}
