binds {
    Mod+Return hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+Shift+Return hotkey-overlay-title="Open Zellij in Kitty" { spawn "kitty" "zellij"; }

    Alt+Shift+E repeat=false hotkey-overlay-title="Power Profile: Copilot+E" { spawn "quickshell" "ipc" "call" "launcher" "power"; }
    Alt+Shift+P repeat=false hotkey-overlay-title="Display Layout: Copilot+P" { spawn "quickshell" "ipc" "call" "launcher" "display"; }
    Alt+Shift+W repeat=false hotkey-overlay-title="Wi-Fi: Copilot+W" { spawn "quickshell" "ipc" "call" "launcher" "wifi"; }
    Alt+Shift+B repeat=false hotkey-overlay-title="Bluetooth: Copilot+B" { spawn "quickshell" "ipc" "call" "launcher" "bluetooth"; }
    Alt+Shift+R repeat=false hotkey-overlay-title="Camera: Copilot+R" { spawn "quickshell" "ipc" "call" "launcher" "camera"; }
    Alt+Shift+V repeat=false hotkey-overlay-title="Voice reply (toggle dictation to pi): Copilot+V" { spawn "/home/sortedcord/Projects/stt_daemon/sttctl" "toggle"; }
    Mod+Period hotkey-overlay-title="Emoji Picker: Emote" { spawn "sh" "-c" "cd $HOME/Applications/emote && exec pipenv run start"; }
    Mod+Space repeat=false hotkey-overlay-title="Launcher: hyprbeam" { spawn "quickshell" "ipc" "call" "launcher" "hyprbeam"; }
    Mod+B hotkey-overlay-title="New Helide Window" { spawn "/home/sortedcord/Applications/helide/helide-wrapper" "--new-window"; }
    Mod+Shift+B hotkey-overlay-title="New Helide Private Window" { spawn "/home/sortedcord/Applications/helide/helide-wrapper" "--incognito" "--new-window"; }
    Mod+Ctrl+B hotkey-overlay-title="Bluetooth Settings" { spawn "blueman-manager"; }
}
